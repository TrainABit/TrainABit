{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@types/*": ["types/*"],
      "@lib/*": ["lib/*"],
      "@store/*": ["store/*"],
      "@data/*": ["data/*"]
    }
  },
  "include": [
    "types/**/*.ts",
    "lib/**/*.ts",
    "store/**/*.ts",
    "data/**/*.ts",
    "scripts/**/*.ts"
  ]
}
